# --- Required ---
# Supabase -> Connect -> Transaction pooler connection string (port 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Domain (set both so Google sees ONE site) ---
# The one address you want people and Google to use, e.g. redant.co.uk. Any other domain 301-redirects here.
CANONICAL_HOST=redant.co.uk
SITE_URL=https://redant.co.uk

# --- Lead emails (https://resend.com, free tier). Without these no emails are sent. ---
RESEND_API_KEY=
MAIL_FROM=RedAnt <hello@redant.co.uk>
NOTIFY_EMAIL=hello@redant.co.uk

# --- Health check tool (optional but recommended: free key from Google Cloud, "PageSpeed Insights API") ---
PAGESPEED_API_KEY=
